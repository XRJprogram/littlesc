# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，切勿提交密钥。

# 模型服务商：deepseek | agnes | mock
MODEL_PROVIDER=mock

# 服务端密钥路径开关（false 时只接受浏览器 BYOK 传入的 key）
ALLOW_SERVER_KEY=false

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=8192

# Agnes AI（OpenAI 兼容）
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# 主商 429/402/5xx 时自动切换的备用服务商
AI_FALLBACK_PROVIDER=

# 截断续写：auto | echo | prefix
AI_CONTINUATION_MODE=auto
MAX_AI_CONTINUATIONS=3
AI_TIMEOUT_MS=600000
AI_PROBE_TIMEOUT_MS=15000
