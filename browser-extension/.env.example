# InstanceScratch 浏览器扩展环境变量模板
# 复制为 .env 后填入你的 API Key；.env 已被 .gitignore 排除，切勿提交。

# 模型服务商（可选：deepseek | kimi | agnes | openai | custom）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_API_KEY=

AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# 自定义 OpenAI 兼容端点
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=
