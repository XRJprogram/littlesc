{
  "manifest_version": 3,
  "name": "InstanceScratch AI 积木注入器",
  "version": "3.3.0",
  "description": "在 Turbowarp 与 Codingclip 图形化 Scratch 编辑器中，用自然语言 + 真实 AI 流式生成积木并注入到当前打开的角色。支持AI删改/替换积木、多轮对话、黑白模式。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://turbowarp.org/*",
    "https://codingclip.com/*"
  ],
  "background": {
    "service_worker": "build/background.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://turbowarp.org/*",
        "https://codingclip.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected-main.js",
        "build/injector.mjs"
      ],
      "matches": [
        "https://turbowarp.org/*",
        "https://codingclip.com/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "InstanceScratch AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
