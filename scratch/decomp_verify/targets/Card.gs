            }
        }
        CardStage_name_lv__4__mhp_buff_[((($stageid - 1) * 8) + 3)] = (CardStage_name_lv__4__mhp_buff_[((($stageid - 1) * 8) + 3)] + $D);
        if ($D > "0") {
            AddEffect "damage+", $stageid, "", "", "", "";
        } else {
